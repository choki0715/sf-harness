#!/usr/bin/env python3
"""sf-signals — 저장된 설비 센서 신호를 '사실'로만 뽑는다.

이 스크립트는 판단하지 않는다. 읽고, 세고, 계산해서 출력할 뿐이다.
판단(멈춰야 하는가, 점검을 예약해야 하는가, 센서가 고장난 것인가)은
스킬이 LLM 에게 시킨다.

왜 스크립트인가:
  LLM 에게 "지난 한 시간 진동 평균이 얼마야?"를 물으면 매번 다르게 답한다.
  CSV 를 읽고 평균을 내는 일은 코드가 한다. 언제나 같은 숫자를 준다.
  LLM 은 "이 추세면 설비를 세워야 하는가"처럼 셀 수 없는 것만 판단한다.

입력 (플랜트 데이터 디렉터리):
  config/thresholds.csv     equipment,sensor,unit,lo_crit,lo_warn,hi_warn,hi_crit
  signals/<EQUIPMENT>.csv   timestamp,sensor,value   (timestamp: YYYY-MM-DDTHH:MM:SS)
  maintenance_log.csv       equipment,date,type,note            (선택)
  work_orders.csv           id,created,equipment,action,when,reason,status   (선택)

출력 형식: `KEY: value` 한 줄씩 (STATUS 라인).
  파싱하기 쉽고, 사람이 읽기도 쉽고, LLM 이 헷갈리지 않는다.
  표나 산문으로 내보내면 LLM 이 요약하다가 숫자를 바꾼다.

표준 라이브러리만 쓴다. pandas 없는 환경에서도 즉시 돌아야 한다.
"""

from __future__ import annotations

import argparse
import csv
import os
import sys
from datetime import datetime, timedelta

PROTO = 1
TS_FMT = "%Y-%m-%dT%H:%M:%S"


def die(msg: str) -> None:
    print(f"ERROR: {msg}")
    raise SystemExit(1)


def fnum(x: float) -> str:
    return f"{x:.2f}"


def fsigned(x: float) -> str:
    return f"{x:+.2f}"


def parse_ts(s: str) -> datetime:
    return datetime.strptime(s.strip(), TS_FMT)


def opt_float(s: str) -> float | None:
    s = (s or "").strip()
    return float(s) if s else None


# ─── 입력 읽기 ──────────────────────────────────────────────────
def load_thresholds(path: str) -> dict[str, dict[str, dict]]:
    """equipment → sensor → {unit, lo_crit, lo_warn, hi_warn, hi_crit} (파일 순서 유지)"""
    table: dict[str, dict[str, dict]] = {}
    with open(path, newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            eq, sensor = row["equipment"].strip(), row["sensor"].strip()
            if not eq or not sensor:
                continue
            table.setdefault(eq, {})[sensor] = {
                "unit": (row.get("unit") or "").strip(),
                "lo_crit": opt_float(row.get("lo_crit")),
                "lo_warn": opt_float(row.get("lo_warn")),
                "hi_warn": opt_float(row.get("hi_warn")),
                "hi_crit": opt_float(row.get("hi_crit")),
            }
    if not table:
        die("thresholds.csv 에 설비가 하나도 없다")
    return table


def load_signals(path: str) -> tuple[list[tuple[datetime, str, float]], int]:
    """(timestamp, sensor, value) 목록과 파싱 실패 줄 수"""
    rows, bad = [], 0
    if not os.path.exists(path):
        return rows, bad
    with open(path, newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            try:
                rows.append((parse_ts(row["timestamp"]), row["sensor"].strip(), float(row["value"])))
            except (KeyError, ValueError, AttributeError):
                bad += 1
    rows.sort(key=lambda r: r[0])
    return rows, bad


def load_last_maintenance(path: str) -> dict[str, datetime]:
    last: dict[str, datetime] = {}
    if not os.path.exists(path):
        return last
    with open(path, newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            try:
                d = datetime.strptime(row["date"].strip(), "%Y-%m-%d")
            except (KeyError, ValueError):
                continue
            eq = row["equipment"].strip()
            if eq not in last or d > last[eq]:
                last[eq] = d
    return last


def load_open_work_orders(path: str) -> dict[str, int]:
    count: dict[str, int] = {}
    if not os.path.exists(path):
        return count
    with open(path, newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            if (row.get("status") or "").strip() == "open":
                eq = (row.get("equipment") or "").strip()
                count[eq] = count.get(eq, 0) + 1
    return count


# ─── 계산 (전부 결정적이다) ──────────────────────────────────────
def level_of(v: float, th: dict) -> int:
    """0=OK 1=WARN 2=CRIT. 한계를 넘었는지 비교만 한다 — 판단이 아니다."""
    if (th["hi_crit"] is not None and v >= th["hi_crit"]) or \
       (th["lo_crit"] is not None and v <= th["lo_crit"]):
        return 2
    if (th["hi_warn"] is not None and v >= th["hi_warn"]) or \
       (th["lo_warn"] is not None and v <= th["lo_warn"]):
        return 1
    return 0


LEVEL_NAME = {0: "OK", 1: "WARN", 2: "CRIT"}


def slope_per_min(points: list[tuple[float, float]]) -> float:
    """최소제곱 기울기. x 는 분, y 는 센서값."""
    n = len(points)
    if n < 2:
        return 0.0
    xm = sum(p[0] for p in points) / n
    ym = sum(p[1] for p in points) / n
    den = sum((p[0] - xm) ** 2 for p in points)
    if den == 0:
        return 0.0
    return sum((p[0] - xm) * (p[1] - ym) for p in points) / den


def streak_from_end(levels: list[int], at_least: int) -> int:
    n = 0
    for lv in reversed(levels):
        if lv >= at_least:
            n += 1
        else:
            break
    return n


def minutes_to_warn(last: float, slope: float, th: dict) -> str:
    """현재 추세가 이어지면 주의 한계에 닿기까지 몇 분인가. 24시간 넘으면 none.
    이미 WARN 이상이면 0. 단순 외삽이다 — 예측이 아니라 산수다."""
    if level_of(last, th) >= 1:
        return "0"
    mins = None
    if slope > 0 and th["hi_warn"] is not None:
        mins = (th["hi_warn"] - last) / slope
    elif slope < 0 and th["lo_warn"] is not None:
        mins = (last - th["lo_warn"]) / (-slope)
    if mins is None or mins > 1440:
        return "none"
    return str(int(round(mins)))


def limits_str(th: dict) -> str:
    parts = []
    if th["lo_crit"] is not None:
        parts.append(f"lo_crit={th['lo_crit']:g}")
    if th["lo_warn"] is not None:
        parts.append(f"lo_warn={th['lo_warn']:g}")
    if th["hi_warn"] is not None:
        parts.append(f"warn={th['hi_warn']:g}")
    if th["hi_crit"] is not None:
        parts.append(f"crit={th['hi_crit']:g}")
    return " ".join(parts) or "none"


# ─── 본체 ───────────────────────────────────────────────────────
def main() -> int:
    ap = argparse.ArgumentParser(description="설비 센서 신호를 사실로 뽑는다")
    ap.add_argument("plant", nargs="?", default=".", help="플랜트 데이터 디렉터리 (기본: 현재)")
    ap.add_argument("--window", type=int, default=60, help="분석 창(분). 기본 60")
    ap.add_argument("--now", help="기준 시각 YYYY-MM-DDTHH:MM:SS (기본: 현재 시각). 테스트·재현용")
    ap.add_argument("--stale-min", type=int, default=10, help="이 분 이상 새 샘플이 없으면 STALE 로 센다")
    ap.add_argument("--flat-n", type=int, default=15, help="마지막 N 샘플이 완전히 같으면 FLATLINE 으로 센다")
    args = ap.parse_args()

    plant = os.path.abspath(args.plant or ".")
    if not os.path.isdir(plant):
        die(f"그런 경로가 없다: {plant}")
    thr_path = os.path.join(plant, "config", "thresholds.csv")
    if not os.path.exists(thr_path):
        die(f"config/thresholds.csv 가 없다: {plant} 는 플랜트 데이터 디렉터리가 아니다")
    sig_dir = os.path.join(plant, "signals")
    if not os.path.isdir(sig_dir):
        die(f"signals/ 디렉터리가 없다: {plant}")

    try:
        now = parse_ts(args.now) if args.now else datetime.now().replace(microsecond=0)
    except ValueError:
        die(f"--now 형식이 틀렸다 (YYYY-MM-DDTHH:MM:SS): {args.now}")
    window_start = now - timedelta(minutes=args.window)

    thresholds = load_thresholds(thr_path)
    last_maint = load_last_maintenance(os.path.join(plant, "maintenance_log.csv"))
    open_wo = load_open_work_orders(os.path.join(plant, "work_orders.csv"))

    print(f"SF_SIGNALS_PROTO: {PROTO}")            # 프로토콜 번호. 스킬이 이 줄로 버전을 확인한다
    print(f"PLANT_DIR: {plant}")
    print(f"NOW: {now.strftime(TS_FMT)}")
    print(f"WINDOW_MIN: {args.window}")
    print(f"RULES: stale_min={args.stale_min} flat_n={args.flat_n}")
    print(f"EQUIPMENT_COUNT: {len(thresholds)}")
    print(f"EQUIPMENT_LIST: {' '.join(thresholds)}")

    alert_crit, alert_warn, suspect, stale_eq = [], [], [], []
    total_samples, total_bad = 0, 0
    latest_any: datetime | None = None

    for eq, sensors in thresholds.items():
        rows, bad = load_signals(os.path.join(sig_dir, f"{eq}.csv"))
        total_bad += bad
        rows = [r for r in rows if r[0] <= now]          # 미래 타임스탬프는 세지 않는다
        print()
        print(f"EQUIPMENT: {eq}")

        # 신선도: 이 설비의 마지막 샘플이 얼마나 오래됐나 (창과 무관하게 파일 전체)
        if rows:
            latest = rows[-1][0]
            latest_any = latest if latest_any is None or latest > latest_any else latest_any
            stale = int((now - latest).total_seconds() // 60)
            print(f"{eq}.LATEST_TS: {latest.strftime(TS_FMT)}")
            print(f"{eq}.STALE_MIN: {stale}")
            is_stale = stale >= args.stale_min
        else:
            print(f"{eq}.LATEST_TS: none")
            print(f"{eq}.STALE_MIN: none")
            is_stale = True
        if is_stale:
            stale_eq.append(eq)

        if eq in last_maint:
            print(f"{eq}.LAST_MAINT: {last_maint[eq].strftime('%Y-%m-%d')}")
            print(f"{eq}.DAYS_SINCE_MAINT: {(now.date() - last_maint[eq].date()).days}")
        else:
            print(f"{eq}.LAST_MAINT: none")
            print(f"{eq}.DAYS_SINCE_MAINT: none")
        print(f"{eq}.OPEN_WORK_ORDERS: {open_wo.get(eq, 0)}")

        in_window = [r for r in rows if r[0] >= window_start]
        missing = []
        for sensor, th in sensors.items():
            pts = [(ts, v) for ts, s, v in in_window if s == sensor]
            n = len(pts)
            total_samples += n
            key = f"{eq}.{sensor}"
            print(f"{key}.LIMITS: {limits_str(th)} unit={th['unit'] or 'none'}")
            if n == 0:
                print(f"{key}.STATUS: NO_DATA")
                print(f"{key}.WINDOW: n=0")
                if not is_stale:
                    missing.append(sensor)   # 설비는 살아 있는데 이 센서만 없다
                continue

            values = [v for _, v in pts]
            levels = [level_of(v, th) for v in values]
            last = values[-1]
            mean = sum(values) / n
            std = (sum((v - mean) ** 2 for v in values) / n) ** 0.5
            gaps = [(pts[i][0] - pts[i - 1][0]).total_seconds() for i in range(1, n)]
            span_min = (pts[-1][0] - pts[0][0]).total_seconds() / 60
            slope = slope_per_min([((ts - window_start).total_seconds() / 60, v) for ts, v in pts])
            tail = values[-args.flat_n:]
            flat = 1 if n >= args.flat_n and len(set(tail)) == 1 else 0
            status = LEVEL_NAME[levels[-1]]

            print(f"{key}.STATUS: {status}")
            print(f"{key}.LAST: {fnum(last)}")
            print(f"{key}.WINDOW: n={n} mean={fnum(mean)} std={fnum(std)} min={fnum(min(values))} "
                  f"max={fnum(max(values))} span_min={span_min:.0f} max_gap_sec={max(gaps):.0f}" if gaps
                  else f"{key}.WINDOW: n={n} mean={fnum(mean)} std={fnum(std)} min={fnum(min(values))} "
                       f"max={fnum(max(values))} span_min=0 max_gap_sec=0")
            print(f"{key}.TREND_PER_HOUR: {fsigned(slope * 60)}")
            print(f"{key}.OVER_WARN: {sum(1 for lv in levels if lv >= 1)}")
            print(f"{key}.OVER_CRIT: {sum(1 for lv in levels if lv >= 2)}")
            print(f"{key}.WARN_STREAK: {streak_from_end(levels, 1)}")
            print(f"{key}.CRIT_STREAK: {streak_from_end(levels, 2)}")
            print(f"{key}.MIN_TO_WARN: {minutes_to_warn(last, slope, th)}")
            print(f"{key}.FLATLINE: {flat}")

            if status == "CRIT":
                alert_crit.append(key)
            elif status == "WARN":
                alert_warn.append(key)
            if flat:
                suspect.append(f"{key}(FLATLINE)")

        print(f"{eq}.MISSING_SENSORS: {' '.join(missing) if missing else 'none'}")
        suspect.extend(f"{eq}.{s}(MISSING)" for s in missing)

    # ─── 요약 (위 사실을 모아 놓은 것이지 새 판단이 아니다) ─────────
    print()
    print(f"SAMPLE_COUNT: {total_samples}")
    print(f"LATEST_TS: {latest_any.strftime(TS_FMT) if latest_any else 'none'}")
    print(f"PARSE_ERRORS: {total_bad}")
    print(f"ALERT_CRIT: {' '.join(alert_crit) if alert_crit else 'none'}")
    print(f"ALERT_WARN: {' '.join(alert_warn) if alert_warn else 'none'}")
    print(f"SENSOR_SUSPECT: {' '.join(suspect) if suspect else 'none'}")
    print(f"STALE_EQUIPMENT: {' '.join(stale_eq) if stale_eq else 'none'}")
    print("SF_SIGNALS_OK")                     # 이 줄이 없으면 스크립트가 중간에 죽은 것이다
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
