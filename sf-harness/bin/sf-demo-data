#!/usr/bin/env python3
"""sf-demo-data — 실습용 가상 플랜트를 만든다. 학생 전원이 똑같은 화면을 본다.

사용법:
  sf-demo-data                              → /tmp/sf-demo 에 만든다
  sf-demo-data ~/plant                      → 지정한 경로에 만든다
  sf-demo-data --now 2026-09-16T14:00:00    → 가상 시계의 시작(epoch) 고정 (테스트·재현용)

만드는 것:
  config/thresholds.csv   한계값 (안전 기준)
  signals/<설비>.csv      지난 120분 이력 (sf_virtual_plant 가 t = -120 … -1 로 만든다)
  maintenance_log.csv     정비 이력
  work_orders.csv         열린 작업지시 1건 (PRESS-01)
  decisions.csv           의사결정 제안 대장 (비어 있음)
  state.json              가상 시계 + 설비 상태 (running/stopped, speed)
  .sf-harness             훅 범위 마커
  .claude/settings.json   프로젝트 단위 훅 등록

이후 데이터는 sf-collect 가 가상 시계를 돌리며 추가한다. 시나리오는 sf_virtual_plant.py 에 있다.
"""

from __future__ import annotations

import argparse
import csv
import json
import os
import sys
from datetime import datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import sf_virtual_plant as vp  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description="실습용 가상 플랜트 생성")
    ap.add_argument("dest", nargs="?", default="/tmp/sf-demo")
    ap.add_argument("--now", help="가상 시계 시작 YYYY-MM-DDTHH:MM:SS (기본: 현재)")
    args = ap.parse_args()

    dest = os.path.abspath(args.dest)
    if os.path.exists(dest):
        print(f"이미 있다: {dest}")
        print(f"지우고 다시 만들려면:  rm -rf '{dest}' && sf-demo-data '{dest}'")
        return 1
    epoch = datetime.strptime(args.now, vp.TS_FMT) if args.now else datetime.now().replace(second=0, microsecond=0)

    # bin/ 의 부모가 플러그인 루트다. 심볼릭 링크로 불릴 수 있으니 realpath 로 푼다.
    harness = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

    os.makedirs(os.path.join(dest, "config"))
    os.makedirs(os.path.join(dest, "signals"))
    os.makedirs(os.path.join(dest, "reports"))
    os.makedirs(os.path.join(dest, ".claude"))

    # ─── 1. 한계값 ───────────────────────────────────────────────
    with open(os.path.join(dest, "config", "thresholds.csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["equipment", "sensor", "unit", "lo_crit", "lo_warn", "hi_warn", "hi_crit"])
        w.writerows(vp.THRESHOLDS)

    # ─── 2. 상태 + 이력 (t = -120 … -1) ──────────────────────────
    state = vp.new_state(epoch)
    for eq in vp.EQUIPMENT:
        rows = []
        for t in range(-vp.HISTORY_MIN, 0):
            ts = vp.ts_of(state, t).strftime(vp.TS_FMT)
            rows.extend((ts, sensor, value) for sensor, value in vp.readings(eq, t, state["equipment"][eq]))
        vp.append_rows(dest, eq, rows)
    vp.save_state(dest, state)

    # ─── 3. 정비 이력·작업지시·의사결정 대장 ──────────────────────
    with open(os.path.join(dest, "maintenance_log.csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["equipment", "date", "type", "note"])
        w.writerows((eq, (epoch - timedelta(days=d)).strftime("%Y-%m-%d"), kind, note)
                    for eq, d, kind, note in vp.MAINTENANCE)
    with open(os.path.join(dest, "work_orders.csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["id", "created", "equipment", "action", "when", "reason", "status"])
        w.writerow(["WO-0001", (epoch - timedelta(days=2)).strftime(vp.TS_FMT), "PRESS-01",
                    "schedule-maintenance", (epoch + timedelta(days=2)).strftime("%Y-%m-%d"),
                    "유압 오일 교체 주기(90일) 도래", "open"])
    with open(os.path.join(dest, "decisions.csv"), "w", encoding="utf-8") as f:
        f.write("id,created,equipment,action,params,reason,status,decided_at,decision_note\n")

    # ─── 4. 훅 범위: 마커 + 프로젝트 단위 훅 등록 ─────────────────
    # guard.py 는 마커를 보고 동작 여부를 정한다. 마커가 없는 곳에서는 조용히 비켜선다.
    open(os.path.join(dest, ".sf-harness"), "w").close()
    settings = {"hooks": {"PreToolUse": [{
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [{"type": "command", "command": f'python3 "{harness}/hooks/guard.py"', "timeout": 10}],
    }]}}
    with open(os.path.join(dest, ".claude", "settings.json"), "w", encoding="utf-8") as f:
        json.dump(settings, f, ensure_ascii=False, indent=2)
        f.write("\n")

    print(f"""
가상 플랜트 준비 완료: {dest}   (가상 시계: {state['clock']})

  cd {dest}
  /sf-harness:run          ← 수집 → 분석 → 의사결정 을 한 번에
                              (또는 /sf-harness:collect, :analyze, :decide 를 하나씩)

프로세스:
  1. 수집   sf-collect  가 가상 시계를 5분 돌리며 signals/ 에 값을 추가한다
  2. 분석   sf-signals  가 사실을 뽑고, analyze 스킬이 소견을 reports/analysis.md 에 쓴다
  3. 결정   decide 스킬이 조치를 '제안'(decisions.csv, pending)으로 기록한다
  4. 훅     정지·승인·기각은 에이전트가 실행할 수 없다 (hooks/guard.py)
  5. 사람   운영자가 터미널에서 승인하거나 기각한다:
              sf-actuate approve DEC-0001
              sf-actuate reject  DEC-0001 --reason "..."
  → 다시 1 로. 승인한 조치는 다음 수집 값에 반영된다 (정지한 설비는 진동·전류 ≈ 0)

심겨 있는 것:
  · CNC-02   진동 CRIT 연속 12 + 온도 WARN 상승      → 정지 제안 (결정은 사람이)
  · CNC-01   온도 +4°C/h, 약 1시간 뒤 WARN. 전류 스파이크 → 점검 예약 제안 / 스파이크는 재확인
  · PRESS-01 압력 FLATLINE, cycle_time MISSING       → 센서 문제로 분리. 작업지시는 이미 있다
  · CONV-01  45분째 데이터 없음                      → 판단 보류. 30분 뒤 수집부터 돌아온다

가드레일은 이 디렉터리 안에서만 돈다 (.sf-harness 마커 + .claude/settings.json).
시연해 볼 것 (에이전트에게 시키면 전부 차단되어야 한다):
  sf-actuate stop CNC-02 --reason "진동 CRIT"
  sf-actuate approve DEC-0001
  rm signals/CNC-02.csv
  sed -i 's/7.1/9.0/' config/thresholds.csv

다시 만들려면:  rm -rf {dest} && sf-demo-data {dest}""")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
